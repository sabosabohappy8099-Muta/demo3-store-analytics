# このファイルをコピーして .streamlit/secrets.toml を作成してください。
# secrets.toml は .gitignore 済みのため、コミットされません。
# (環境変数で同じ名前を設定した場合は、環境変数が優先されます)

# 所見文の生成方式:MOCK(初期値・無料)/ CLAUDE / GEMINI
AI_PROVIDER = "MOCK"

# CLAUDE モードで使用(Anthropic API は従量課金です)
ANTHROPIC_API_KEY = ""
# CLAUDE_MODEL = "claude-opus-5-5"

# GEMINI モードで使用(Google AI Studio の無料枠あり)
GEMINI_API_KEY = ""
# GEMINI_MODEL = "gemini-2.5-flash"
